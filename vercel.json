{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/health",                       "dest": "api/health.ts" },
    { "src": "/api/invoices",                     "dest": "api/invoices/index.ts" },
    { "src": "/api/invoices/([^/]+)",             "dest": "api/invoices/[id].ts" },
    { "src": "/api/escrow/fund",                  "dest": "api/escrow/fund.ts" },
    { "src": "/api/escrow/release",               "dest": "api/escrow/release.ts" },
    { "src": "/api/stellar/account/([^/]+)",      "dest": "api/stellar/account/[address].ts" },
    { "src": "/api/stellar/build-tx",             "dest": "api/stellar/build-tx.ts" }
  ]
}